part --source rawcopy --sourceparams="file=bl2_bp_esd-${MACHINE}.bin" --no-table
part --source rawcopy --sourceparams="file=fip-${MACHINE}.bin" --no-table ${FIP_WIC_OFFSET} --align 64

# Partition 1: Boot (FAT) - Optional, can hold the boot.scr if U-Boot can't read ext4 /boot
part --source bootimg-partition --fstype=vfat --label boot --active --align 4 --fixed-size 64M

# Partition 2: Rootfs A
part / --source rootfs --fstype=ext4 --label root_A --align 4 --fixed-size 2048M

# Partition 3: Rootfs B
part --source rootfs --fstype=ext4 --label root_B --align 4 --fixed-size 2048M

# Partition 4: Data
part --fstype=ext4 --label data --align 4 --size 1024M --no-fstab-update
